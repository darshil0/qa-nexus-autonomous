# Google Gemini API Key (Server-side ONLY - Required)
# Get your key from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Client-side Supabase Configuration (for data persistence)
# Get credentials from: https://supabase.com
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ⚠️ SECURITY NOTICE:
# - Never expose private API keys in VITE_ variables
# - GEMINI_API_KEY is restricted to server runtime and is not built into browser bundles
# - Keep your credentials secure and rotate them regularly
